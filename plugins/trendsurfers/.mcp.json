{
  "mcpServers": {
    "ts-portfolio-manager": {
      "type": "http",
      "url": "${PM_MCP_URL:-http://127.0.0.1:8765/mcp}",
      "headers": { "Authorization": "Bearer ${PM_MCP_TOKEN}" }
    },
    "strategy-lens": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@trendsurfers/strategy-lens-mcp@latest", "${PM_SL_REPORTS_ROOT:-}", "${SL_REPORTS_ROOT:-}"]
    }
  }
}
